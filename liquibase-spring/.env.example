# liquibase-spring ortam degiskenleri.
# Bu dosyayi ".env" adiyla kopyalayip doldurun. run.cmd .env'i okuyup
# degiskenleri process ortamina yukler, Spring de ymllerdeki ${...}
# yer tutucularini bunlardan cozer.
#
# KURALLAR:
#   - KEY=VALUE, esittirin etrafinda BOSLUK BIRAKMAYIN
#   - Degerleri TIRNAK ICINE ALMAYIN (tirnaklar degerin parcasi sayilir)
#   - "#" ile baslayan satirlar yorumdur
#   - Sifrede ! veya % varsa batch'te sorun cikarabilir; varsa haber verin

# --- STAGING ---
STAGING_DB_URL=jdbc:postgresql://SUNUCU:PORT/VERITABANI?currentSchema=portal
STAGING_DB_USERNAME=
STAGING_DB_PASSWORD=
STAGING_DB_SCHEMA=portal

# --- PROD ---
PROD_DB_URL=jdbc:postgresql://SUNUCU:PORT/VERITABANI?currentSchema=portal
PROD_DB_USERNAME=
PROD_DB_PASSWORD=
PROD_DB_SCHEMA=portal
