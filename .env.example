WEBEX_BOT_TOKEN=
# Bu bilgisayardaki kopyanin dinledigi islemler (virgulle). Bos ya da "all" = hepsi.
# Bot birden fazla bilgisayarda calisiyorsa her birine farkli islemler verin
# (or. birinde 1,2,3 digerinde 4,6). Cakisma kontrol edilmez.
DINLENEN_ISLEMLER=
WEBEX_ROOM_ID_GRUP1=
WEBEX_ROOM_ID_GRUP1_YETKILER=
WEBEX_ROOM_ID_GRUP2=
WEBEX_ROOM_ID_GRUP2_YETKILER=
PROD_LOGIN_URI=
PROD_ADMIN_USERNAME=
PROD_ADMIN_PASSWORD=
ADMIN_TEMPORARY_PASSWORD_URI=
ADMIN_TEMPORARY_CHANGE_AES_PASSWORD=
SHARED_FOLDER=
PROD_POSTGRES_IP=
PROD_POSTGRES_PORT=
PROD_POSTGRES_USERNAME=
PROD_PORTGRES_PASSWORD=
PROD_POSTGRES_DB=
PROD_POSTGRES_SCHEMA=
ARGO_USERNAME=
ARGO_PASSWORD=
# 6. islem (liquibase). Veritabani bilgileri burada DEGIL,
# liquibase-spring/.env icindedir (run.cmd oradan okur).
LIQUIBASE_SOURCE_REPO=
LIQUIBASE_SOURCE_BRANCH=
LIQUIBASE_PROJECT_DIR=liquibase-spring
LIQUIBASE_TIMEOUT_MS=
# 5. islem (branch kod incelemesi). Depo olarak LIQUIBASE_SOURCE_REPO kullanilir
# (checkout yapilmaz, yalnizca branch fetch edilir).
# Yerel, OpenAI uyumlu model: LLM_BASE_URL sonu /v1 olan adres (or. http://sunucu:port/v1),
# LLM_API_KEY basina "Bearer" yazmadan da verilebilir.
# Bos birakilanlarin varsayilanlari: LLM_MODEL=strata, LLM_REASONING_EFFORT=high
# ("-" = hic gonderme), LLM_MAX_TOKENS=49152, LLM_TIMEOUT_MS=1800000,
# KOD_REVIEW_MAX_COMMIT=30, KOD_REVIEW_MAX_DIFF_CHARS=300000.
# Sinir istemiyorsaniz bu ikisine 0 ya da "sinirsiz" yazin (cok buyuk sayi da
# sinirsiz sayilir). DIKKAT: diff sinirsizken buyuk branch'ler modelin baglam
# penceresini (262k token) asip hata verebilir.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=
LLM_TIMEOUT_MS=
KOD_REVIEW_MAX_COMMIT=
KOD_REVIEW_MAX_DIFF_CHARS=
# Inceleme ajani: model, kodu (dosya oku/ara/commit diff) ve STAGING veritabanini
# YALNIZCA OKUYARAK arastirir. STAGING bilgileri liquibase-spring/.env'deki
# STAGING_DB_* satirlarindan okunur (PROD satirlarina hic bakilmaz).
# Bos birakilanlarin varsayilanlari: LLM_CONTEXT_WINDOW=262144 (baglamin %75'i
# dolunca konusma sikistirilir), KOD_REVIEW_MAX_ADIM=40, KOD_REVIEW_TOPLAM_SURE_MS=3600000.
# KOD_REVIEW_STAGING=kapali → staging erisimi yok; KOD_REVIEW_ARACLAR=kapali → hic arac
# yok (eski tek seferlik inceleme).
LLM_CONTEXT_WINDOW=
KOD_REVIEW_MAX_ADIM=
KOD_REVIEW_TOPLAM_SURE_MS=
KOD_REVIEW_STAGING=
KOD_REVIEW_ARACLAR=
